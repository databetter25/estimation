---
/** 개념 페이지 → 실험실 프리셋 링크 ("직접 확인해 보기 →") */
interface Props {
  to: string;
  label?: string;
  note?: string;
}
const { to, label = '직접 확인해 보기', note } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="tryit">
  <a class="btn-filled" href={`${base}/${to}`}>{label} →</a>
  {note && <span class="tryit-note">{note}</span>}
</div>

<style>
  .tryit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin: 32px 0;
    padding: 22px 24px;
    background: var(--c-blue-bg);
    border-radius: var(--r-lg);
  }
  .tryit-note {
    font-size: 0.88rem;
    color: var(--c-text-secondary);
  }
</style>
