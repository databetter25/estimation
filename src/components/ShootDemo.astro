---
/** "한 발씩 쏘기" (TGT-5): 균등분포 U(0,10), n = 20 에서 과녁 (a)(b)(c)를 한 발씩 만든다 */
import { ESTIMATOR_META } from '../data/estimators';
import { tex } from '../lib/tex';
const ids = ['umvue', 'xmax', 'mme'] as const;
---

<section class="shoot" aria-label="한 발씩 쏘기 데모">
  <div class="shoot-head">
    <div>
      <p class="shoot-model">
        모집단 <span set:html={tex('U(0,\\ \\theta=10)')} />, 표본 크기 <span set:html={tex('n=20')} />
      </p>
      <p class="shoot-count" aria-live="polite"><b data-shots>0</b>발 · 표본 <b data-samples>0</b>개</p>
    </div>
    <div class="shoot-btns">
      <button type="button" class="btn-filled sm" data-shoot="1">한 발 쏘기</button>
      <button type="button" class="btn-outline sm" data-shoot="10">10발</button>
      <button type="button" class="btn-outline sm" data-shoot="300">300발 연속</button>
      <button type="button" class="btn-ghost" data-reset>처음부터</button>
    </div>
  </div>

  <figure class="strip-fig">
    <svg class="strip" data-strip role="img" aria-label="가장 최근 표본 20개와 세 추정치의 위치"></svg>
    <figcaption>
      가장 최근에 뽑은 표본 20개(회색 점)와 그 표본으로 계산한 세 추정치(▼). 세로선이 참값 θ = 10.
      <span class="strip-legend">
        <span><i style="color:var(--viz-s3)">▼</i> UMVUE</span>
        <span><i style="color:var(--viz-s2)">▼</i> MLE</span>
        <span><i style="color:var(--viz-s1)">▼</i> MME</span>
      </span>
    </figcaption>
  </figure>

  <div class="shoot-cards">
    {
      ids.map((id) => (
        <article class="shoot-card" data-est={id}>
          <header>
            <span class="est-sym" set:html={tex(ESTIMATOR_META[id].tex)} />
            <span class="shoot-method">{ESTIMATOR_META[id].method}</span>
            <span class="badge badge-gray" data-type>모으는 중</span>
          </header>
          <canvas class="target" role="img" aria-label={`${ESTIMATOR_META[id].name} 과녁`} />
          <dl class="mini">
            <div><dt>편향</dt><dd data-k="bias">—</dd></div>
            <div><dt>표준편차</dt><dd data-k="sd">—</dd></div>
            <div><dt>MSE</dt><dd data-k="mse">—</dd></div>
          </dl>
        </article>
      ))
    }
  </div>
  <p class="shoot-note">
    한 발 = 독립 표본 두 개. 첫 표본의 추정치가 가로 좌표, 둘째 표본의 추정치가 세로 좌표입니다. 유형 배지는 표본 잡음이 줄어드는 100발 이후부터 판정합니다.
  </p>
</section>

<script>
  import { initShoot } from '../lib/ui/shoot';
  document.querySelectorAll<HTMLElement>('.shoot').forEach((el) => initShoot(el));
</script>

<style is:global>
  .shoot {
    margin: 32px 0;
    padding: 24px;
    border: 1px solid var(--c-border-lt);
    border-radius: var(--r-xl);
    background: var(--c-bg-subtle);
  }
  .shoot-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .shoot-model,
  .shoot-count {
    margin: 0;
    font-size: 0.9rem;
  }
  .shoot-count {
    color: var(--c-text-secondary);
    font-variant-numeric: tabular-nums;
  }
  .shoot-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .strip-fig {
    margin: 18px 0 8px;
  }
  .strip {
    width: 100%;
    display: block;
  }
  .strip-fig figcaption {
    font-size: 0.76rem;
    color: var(--c-text-secondary);
  }
  .strip-legend {
    display: inline-flex;
    gap: 12px;
    margin-left: 8px;
  }
  .strip-legend i {
    font-style: normal;
  }
  .shoot-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 14px;
  }
  @media (max-width: 640px) {
    .shoot-cards {
      grid-template-columns: 1fr;
    }
  }
  .shoot-card {
    background: var(--c-bg);
    border: 1px solid var(--c-border-lt);
    border-radius: var(--r-lg);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .shoot-card header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .shoot-method {
    font-size: 0.74rem;
    color: var(--c-text-tertiary);
    margin-right: auto;
  }
  .shoot-card canvas {
    display: block;
    width: 100%;
  }
  .shoot-note {
    font-size: 0.78rem;
    color: var(--c-text-secondary);
    margin: 12px 0 0 !important;
  }
  .shoot .mini {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-border-lt);
    border-radius: var(--r-sm);
    overflow: hidden;
    margin: 0;
  }
  .shoot .mini div {
    background: var(--c-bg-subtle);
    padding: 6px 8px;
    text-align: center;
  }
  .shoot .mini dt {
    font-size: 0.66rem;
    color: var(--c-text-tertiary);
  }
  .shoot .mini dd {
    margin: 0;
    font-size: 0.84rem;
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
  }
</style>
