---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { CHAPTERS } from '../data/chapters';

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const { title, description = '점추정 이론을 브라우저 시뮬레이션과 과녁 그림으로 배우는 수리통계 교육 사이트', current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}/${p}`;
const pageTitle = title === '홈' ? '추정량 과녁 실험실' : `${title} · 추정량 과녁 실험실`;
const NAV = [
  { label: '개념', path: 'learn/statistic', match: 'learn/' },
  { label: '실험실', path: 'lab/mu', match: 'lab/' },
  { label: '일치성', path: 'consistency', match: 'consistency' },
  { label: '한계', path: 'limits', match: 'limits' },
  { label: '정리', path: 'summary', match: 'summary' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <nav class="topnav" aria-label="주 메뉴">
      <div class="nav-inner">
        <a class="brand" href={`${base}/`}>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <circle cx="10" cy="10" r="5.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <circle cx="10" cy="10" r="1.8" fill="currentColor"></circle>
          </svg>
          <span>추정량 과녁 실험실</span>
        </a>
        <ul class="nav-links">
          {
            NAV.map((n) => (
              <li>
                <a href={href(n.path)} aria-current={current.startsWith(n.match) ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button class="theme-btn" type="button" aria-label="라이트/다크 모드 전환" data-theme-toggle>
          <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><g stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></g
            ></svg
          >
          <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor"></path></svg
          >
        </button>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="foot-grid">
          <div>
            <p class="foot-brand">추정량 과녁 실험실</p>
            <p class="foot-text">
              모든 시뮬레이션은 여러분의 브라우저 안에서 실행됩니다. 서버로 보내는 데이터는 없습니다.
            </p>
          </div>
          <nav aria-label="전체 목차">
            <ul class="foot-links">
              {CHAPTERS.map((c) => (
                <li><a href={href(c.path)}>{c.num}. {c.title}</a></li>
              ))}
              <li><a href={href('about')}>사이트 정보 · 라이선스</a></li>
            </ul>
          </nav>
        </div>
        <p class="foot-legal">
          콘텐츠 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ko" rel="license">CC BY-NC-SA 4.0</a> · 코드 MIT
          라이선스
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
      const sync = () => btn.setAttribute('aria-pressed', String(isDark()));
      sync();
      btn.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        sync();
        document.dispatchEvent(new Event('themechange'));
      });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        sync();
        document.dispatchEvent(new Event('themechange'));
      });

      // 스크롤 진입 모션
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const delay = +(e.target as HTMLElement).dataset.delay! || 0;
            setTimeout(() => e.target.classList.add('vis'), delay);
            io.unobserve(e.target);
          });
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll<HTMLElement>('.reveal').forEach((el, i) => {
        el.dataset.delay ??= String((i % 5) * 90);
        io.observe(el);
      });
    </script>

    <style>
      .topnav {
        height: 52px;
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 200;
        background: var(--c-nav-bg);
        backdrop-filter: saturate(180%) blur(24px);
        -webkit-backdrop-filter: saturate(180%) blur(24px);
        border-bottom: 1px solid var(--c-nav-border);
      }
      .nav-inner {
        max-width: 1080px;
        height: 100%;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        gap: 24px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: var(--fw-semibold);
        font-size: 0.92rem;
        color: var(--c-text-primary);
        white-space: nowrap;
        text-decoration: none !important;
      }
      .brand svg {
        color: var(--c-blue);
      }
      .nav-links {
        display: flex;
        gap: 22px;
        list-style: none;
        margin: 0 0 0 auto;
        padding: 0;
      }
      .nav-links a {
        font-size: 0.82rem;
        color: var(--c-text-secondary);
        text-decoration: none;
      }
      .nav-links a:hover,
      .nav-links a[aria-current='page'] {
        color: var(--c-text-primary);
      }
      .nav-links a[aria-current='page'] {
        font-weight: var(--fw-semibold);
      }
      .theme-btn {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: var(--c-text-secondary);
        cursor: pointer;
      }
      .theme-btn:hover {
        background: var(--c-bg-alt);
        color: var(--c-text-primary);
      }
      .theme-btn .i-moon {
        display: none;
      }
      .theme-btn[aria-pressed='true'] .i-moon {
        display: block;
      }
      .theme-btn[aria-pressed='true'] .i-sun {
        display: none;
      }
      @media (max-width: 720px) {
        .nav-inner {
          padding: 0 12px;
          gap: 10px;
        }
        .brand span {
          display: none;
        }
        .nav-links {
          gap: 14px;
          overflow-x: auto;
        }
        .nav-links a {
          font-size: 0.8rem;
          white-space: nowrap;
        }
      }
      .site-footer {
        background: var(--c-bg-alt);
        border-top: 1px solid var(--c-border-lt);
        padding: 56px 0 40px;
        margin-top: 0;
        font-size: 0.8rem;
        color: var(--c-text-secondary);
      }
      .foot-grid {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 32px;
      }
      @media (max-width: 720px) {
        .foot-grid {
          grid-template-columns: 1fr;
        }
      }
      .foot-brand {
        font-weight: var(--fw-semibold);
        color: var(--c-text-primary);
        margin: 0 0 8px;
      }
      .foot-text {
        margin: 0;
        line-height: 1.7;
      }
      .foot-links {
        list-style: none;
        margin: 0;
        padding: 0;
        columns: 2;
        column-gap: 24px;
      }
      .foot-links li {
        margin: 0 0 6px;
        break-inside: avoid;
      }
      .foot-links a {
        color: var(--c-text-secondary);
      }
      .foot-legal {
        margin: 32px 0 0;
        padding-top: 20px;
        border-top: 1px solid var(--c-border-lt);
      }
    </style>
  </body>
</html>
