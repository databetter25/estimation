---
import Base from '../layouts/Base.astro';
import { CHAPTERS } from '../data/chapters';
import { Rng } from '../lib/engine/rng';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 홈 화면의 과녁 세 개 (빌드 시점에 고정 시드로 생성)
const rng = new Rng(7);
const kinds = [
  { key: 'a', label: '(a) 불편·고효율', cls: 'badge-green', bias: 0, sd: 0.32, note: '정중앙에 조밀하게' },
  { key: 'b', label: '(b) 편향·고효율', cls: 'badge-yellow', bias: -0.85, sd: 0.3, note: '벗어났지만 촘촘하게' },
  { key: 'c', label: '(c) 불편·저효율', cls: 'badge-blue', bias: 0, sd: 0.85, note: '중심 주위로 넓게' },
].map((k) => ({
  ...k,
  pts: Array.from({ length: 140 }, () => [k.bias + k.sd * rng.normal(), k.bias + k.sd * rng.normal()]).filter(
    ([x, y]) => x * x + y * y < 3.9,
  ),
}));
const S = 50; // px per unit, 반지름 2 → 100px
---

<Base title="홈" current="">
  <section class="hero">
    <div class="container">
      <p class="eyebrow hero-el" style="animation-delay:.2s">수리통계 · 점추정 시뮬레이션</p>
      <h1 class="hero-title hero-el" style="animation-delay:.35s">
        추정량을 <span class="grad-text">과녁</span>으로 보다
      </h1>
      <p class="desc hero-desc hero-el" style="animation-delay:.5s">
        표본평균은 왜 최선일까? 편향이 있는 추정량이 왜 더 정확할 수 있을까? 브라우저에서 수천 번 반복 실험을 돌려, 추정량의 편향과
        분산을 과녁 위의 탄착군으로 직접 확인합니다.
      </p>
      <div class="hero-btns hero-el" style="animation-delay:.65s">
        <a class="btn-filled lg" href={`${base}/learn/statistic`}>학습 시작</a>
        <a class="btn-outline" href={`${base}/lab/sigma2`}>실험실 바로 가기</a>
      </div>
      <div class="hero-chips hero-el" style="animation-delay:.8s">
        <span class="chip">MME · MLE · UMVUE</span>
        <span class="chip">편향-분산 절충</span>
        <span class="chip">크래머-라오 하한</span>
        <span class="chip">일치성</span>
        <span class="chip">강건성</span>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">좋은 추정량의 조건</p>
      <h2 class="sec-title">과녁 하나가 <span class="grad-text">성적표</span> 하나</h2>
      <p class="desc sec-desc">
        같은 실험을 반복해 얻은 추정치를 과녁에 찍습니다. 정중앙이 참값입니다. 탄착군의 중심이 어긋나면 편향, 넓게 퍼지면 분산이
        큰 것입니다. 둘을 합친 것이 평균제곱오차(MSE)입니다.
      </p>
      <div class="targets">
        {
          kinds.map((k, i) => (
            <figure class="t-card reveal" data-delay={i * 90}>
              <svg viewBox="-110 -110 220 220" role="img" aria-label={`${k.label} 예시 과녁`}>
                {[4, 3, 2, 1].map((r) => (
                  <circle r={(r * 100) / 4} class={r % 2 === 0 ? 'ring2' : 'ring'} />
                ))}
                <line x1="-100" x2="100" y1="0" y2="0" class="cross" />
                <line y1="-100" y2="100" x1="0" x2="0" class="cross" />
                {k.pts.map(([x, y]) => (
                  <circle cx={(x * S).toFixed(1)} cy={(-y * S).toFixed(1)} r="2.6" class="pt" />
                ))}
                <circle cx={k.bias * S} cy={-k.bias * S} r={k.sd * S} class="sd" />
                <circle cx={k.bias * S} cy={-k.bias * S} r="6" class="ctr" />
              </svg>
              <figcaption>
                <span class={`badge ${k.cls}`}>{k.label}</span>
                <span class="t-note">{k.note}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="sec-more"><a href={`${base}/learn/criteria`}>과녁 직접 쏴 보기 →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">학습 경로</p>
      <h2 class="sec-title">개념과 실험을 <span class="grad-text">번갈아</span></h2>
      <p class="desc sec-desc">왜 최적을 따지는지에서 시작해, 추정량을 만들고, 과녁으로 평가하고, 그 한계까지 갑니다.</p>
      <ol class="path">
        {
          CHAPTERS.map((c) => (
            <li class="reveal">
              <a class="list-row" href={`${base}/${c.path}`}>
                <span class="row-num">{c.num}</span>
                <span class="row-body">
                  <span class="row-title">{c.title}</span>
                  <span class="row-sum">{c.summary}</span>
                </span>
                <span class={`badge ${c.kind === '개념' ? 'badge-gray' : 'badge-blue'}`}>{c.kind}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">믿을 수 있는 실험</p>
      <h2 class="sec-title">숫자는 <span class="grad-text">이론값</span>과 맞아야 한다</h2>
      <div class="feats">
        <article class="feat-card reveal">
          <div class="feat-ico" aria-hidden="true">⚙︎</div>
          <h3>브라우저 안에서 실행</h3>
          <p>
            시뮬레이션은 Web Worker에서 돌아갑니다. 2,000번 반복이 눈 깜빡할 사이에 끝나고, 데이터는 어디로도 보내지 않습니다.
          </p>
        </article>
        <article class="feat-card reveal">
          <div class="feat-ico" aria-hidden="true">#</div>
          <h3>시드로 재현</h3>
          <p>시드와 설정이 같으면 결과도 같습니다. 설정 링크를 복사해 수업 자료나 질문에 그대로 붙이세요.</p>
        </article>
        <article class="feat-card reveal">
          <div class="feat-ico" aria-hidden="true">✓</div>
          <h3>이론값과 나란히</h3>
          <p>모든 지표 옆에 이론 MSE와 크래머-라오 하한을 함께 보여 줍니다. 엔진은 이론값 대조 테스트를 통과합니다.</p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 120px 0 100px;
    text-align: center;
    background: radial-gradient(60% 50% at 50% 0%, var(--c-blue-bg), transparent 70%);
  }
  .hero-title {
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    font-weight: var(--fw-bold);
    letter-spacing: -2.5px;
    line-height: 1.1;
    margin: 0 0 24px;
  }
  .hero-desc {
    max-width: 640px;
    margin: 0 auto 36px;
    font-size: 1.08rem;
  }
  .hero-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 36px;
  }
  .sec-title {
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    font-weight: var(--fw-bold);
    letter-spacing: -1px;
    margin-bottom: 14px;
  }
  .sec-desc {
    max-width: 680px;
    margin: 0 0 40px;
  }
  .targets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 720px) {
    .targets {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin: 0 auto;
    }
  }
  .t-card {
    margin: 0;
    background: var(--c-bg);
    border: 1px solid var(--c-border-lt);
    border-radius: var(--r-lg);
    padding: 22px;
    text-align: center;
  }
  .t-card svg {
    width: 100%;
    max-width: 240px;
    display: block;
    margin: 0 auto 14px;
  }
  .t-card figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .t-note {
    font-size: 0.84rem;
    color: var(--c-text-secondary);
  }
  .ring {
    fill: var(--viz-ring);
    stroke: var(--viz-grid);
  }
  .ring2 {
    fill: var(--viz-ring-2);
    stroke: var(--viz-grid);
  }
  .cross {
    stroke: var(--viz-grid);
  }
  .pt {
    fill: var(--viz-s1);
    opacity: 0.7;
  }
  .sd {
    fill: none;
    stroke: var(--viz-ink);
    stroke-width: 2;
    stroke-dasharray: 5 4;
  }
  .ctr {
    fill: var(--viz-ink);
    stroke: var(--viz-surface);
    stroke-width: 2;
  }
  .sec-more {
    margin: 28px 0 0;
    text-align: center;
  }
  .path {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--c-border-lt);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .list-row {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 22px 26px;
    border-bottom: 1px solid var(--c-border-lt);
    color: inherit;
    text-decoration: none !important;
    transition: background var(--dur-fast);
  }
  .path li:last-child .list-row {
    border-bottom: none;
  }
  .list-row:hover {
    background: var(--c-bg-subtle);
  }
  .row-num {
    width: 48px;
    height: 48px;
    border-radius: var(--r-md);
    background: var(--c-bg-alt);
    display: grid;
    place-items: center;
    font-weight: var(--fw-bold);
    color: var(--c-blue);
    font-size: 0.92rem;
  }
  .row-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .row-title {
    font-weight: var(--fw-semibold);
  }
  .row-sum {
    font-size: 0.84rem;
    color: var(--c-text-secondary);
    line-height: 1.55;
  }
  @media (max-width: 560px) {
    .list-row {
      grid-template-columns: 40px 1fr;
      padding: 18px 16px;
      gap: 14px;
    }
    .row-num {
      width: 40px;
      height: 40px;
    }
    .list-row .badge {
      display: none;
    }
  }
  .feats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  @media (max-width: 860px) {
    .feats {
      grid-template-columns: 1fr;
    }
  }
  .feat-ico {
    width: 48px;
    height: 48px;
    border-radius: var(--r-md);
    background: var(--c-bg-alt);
    display: grid;
    place-items: center;
    font-size: 1.3rem;
    color: var(--c-blue);
    margin-bottom: 18px;
  }
  .feat-card h3 {
    font-size: 1.05rem;
    font-weight: var(--fw-semibold);
    margin-bottom: 8px;
  }
  .feat-card p {
    font-size: 0.9rem;
    color: var(--c-text-secondary);
    margin: 0;
  }
</style>
